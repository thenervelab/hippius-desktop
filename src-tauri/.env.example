# Template for src-tauri/.env, which is gitignored but must exist: tauri.conf.json
# lists it as a bundle resource, and main.rs loads it at runtime via dotenvy.
#
# Run `pnpm setup:env` instead of copying this by hand — it resolves the key from
# an installed Hippius build or $INDEXER_API_KEY and writes the file for you.
# CI never uses this template; the release workflows write the file from the
# TAURI_ENV_FILE repository secret.

# Required. Without it every indexer-backed screen — the home page's Available
# Credits and Storage Usage cards, the storage total, the billing charts — renders
# a zero rather than an error, which reads as a data bug rather than a setup gap.
INDEXER_API_KEY=

# Optional. Defaults to https://indexer.hippius.network (api/indexer.rs).
# HIPPIUS_INDEXER_URL=

# Optional. Points share links at a non-production console; the staging release
# workflow sets this to https://console.hippicode.com.
# HIPPIUS_CONSOLE_BASE_URL=
