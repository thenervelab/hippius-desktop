{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hippius",
  "version": "0.1.94",
  "identifier": "hippius.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTFGQjM3MDcyRjIzNEYKUldSUEl5OEhOL3NSNUdYMmxpUG1WUWtiTWd1TDRjMkt6aXBveFdmYmx3TjJTd01UUW1IMmJGZUgK",
      "endpoints": [
        "https://github.com/thenervelab/hippius-desktop/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hippiusapp"]
      }
    },
    "shell": {
      "open": true
    }
  },
  "app": {
    "windows": [
      {
        "dragDropEnabled": true,
        "title": "Hippius",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 16 },
        "width": 1320,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650,
        "visible": true,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.hippius.com https://arion.hippius.com https://eu-central-1-arion.hippius.com https://us-east-1-arion.hippius.com https://console.hippius.com wss://rpc.hippius.network; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.hippius/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "icons",
      "icons/icon.png",
      "icons/TrayIcon.png",
      "icons/SyncingTrayIcon.png",
      "icons/SyncCompletedTrayIcon.png",
      "icons/*.png",
      "icons/generic-image.png",
      ".env"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "hippius.com",
      "frameworks": [],
      "providerShortName": "Hippius",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  }
}
