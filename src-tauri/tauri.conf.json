{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hippius",
  "version": "0.6.1-beta.1",
  "identifier": "hippius.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTFGQjM3MDcyRjIzNEYKUldSUEl5OEhOL3NSNUdYMmxpUG1WUWtiTWd1TDRjMkt6aXBveFdmYmx3TjJTd01UUW1IMmJGZUgK",
      "endpoints": [
        "https://github.com/thenervelab/hippius-desktop/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hippiusapp"]
      }
    },
    "shell": {
      "open": true
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "dragDropEnabled": true,
        "title": "Hippius",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 27 },
        "width": 1320,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650,
        "visible": true,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default", "tray-panel"],
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.hippius.com https://arion.hippius.com https://eu-central-1-arion.hippius.com https://us-east-1-arion.hippius.com https://console.hippius.com wss://rpc.hippius.network wss://hippius-testnet.starkleytech.com wss://test.finney.opentensor.ai:443; worker-src 'self' blob:; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.hippius/preview-cache/**",
          "$HOME/.hippius/thumbnail-cache/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "icons",
      "icons/icon.png",
      "icons/TrayIcon.png",
      "icons/SyncingTrayIcon.png",
      "icons/SyncCompletedTrayIcon.png",
      "icons/*.png",
      "icons/generic-image.png",
      ".env"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "hippius.com",
      "frameworks": [],
      "providerShortName": "Hippius",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["python3-nautilus"],
        "files": {
          "/usr/share/nautilus-python/extensions/hippius-share.py": "../linux/nautilus-python/hippius-share.py",
          "/usr/share/kio/servicemenus/hippius-share.desktop": "../linux/servicemenus/hippius-share.desktop",
          "/usr/share/nemo/actions/hippius-share.nemo_action": "../linux/nemo/hippius-share.nemo_action",
          "/usr/share/hippius/shell-integration/install-shell-integration.sh": "../linux/install-shell-integration.sh",
          "/usr/share/hippius/shell-integration/README.md": "../linux/README.md",
          "/usr/share/hippius/shell-integration/nautilus/Share with Hippius": "../linux/nautilus/Share with Hippius",
          "/usr/share/hippius/shell-integration/caja/Share with Hippius": "../linux/caja/Share with Hippius",
          "/usr/share/hippius/shell-integration/nemo/hippius-share.nemo_action": "../linux/nemo/hippius-share.nemo_action",
          "/usr/share/hippius/shell-integration/servicemenus/hippius-share.desktop": "../linux/servicemenus/hippius-share.desktop",
          "/usr/share/hippius/shell-integration/thunar/uca-snippet.xml": "../linux/thunar/uca-snippet.xml"
        },
        "postInstallScript": "../linux/deb/postinst.sh"
      }
    }
  }
}
