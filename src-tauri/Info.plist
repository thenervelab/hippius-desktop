<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Hippius</string>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundleIdentifier</key>
    <string>hippius.com</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Hippius</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- CFBundleShortVersionString / CFBundleVersion are deliberately ABSENT.
         Tauri merges this file OVER its generated Info.plist, so a version key
         here wins against `version` in tauri.conf.json. That is how every
         shipped build reported `0.0.1` while the project was on 0.3.4: the
         value was pinned here in the pre-1.0 era and never touched again.
         The damage is diagnostic, not functional — with no build reporting its
         real version, "which build are you on?" is unanswerable, which is what
         made a missing Finder extension take four rounds to pin down. Let Tauri
         generate both keys from tauri.conf.json; that file is the one source of
         truth for the version. Pinned by tests/bundle_metadata_pin.rs. -->
    <key>LSMinimumSystemVersion</key>
    <string>10.13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSUIElement</key>
    <false/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>hippius.com</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>hippiusapp</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Hippius may need microphone access for voice features.</string>
    <key>NSCameraUsageDescription</key>
    <string>Hippius may need camera access for media features.</string>
    <!-- Removed usage descriptions for system folders to avoid permission prompts at startup.
         The user will use the file picker dialog to explicitly select folders for syncing. -->
    <!-- <key>NSPhotoLibraryUsageDescription</key>
    <string>Hippius needs access to your photo library to sync media files.</string> -->
    <!-- <key>NSDocumentsFolderUsageDescription</key>
    <string>Hippius needs access to your documents folder to sync files.</string> -->
    <!-- <key>NSDownloadsFolderUsageDescription</key>
    <string>Hippius needs access to your downloads folder to sync files.</string> -->
    <!-- <key>NSDesktopFolderUsageDescription</key>
    <string>Hippius needs access to your desktop folder to sync files.</string> -->
    <!-- <key>NSMusicUsageDescription</key>
    <string>Hippius needs access to your music folder to sync media files.</string> -->
    <!-- <key>NSMoviesUsageDescription</key>
    <string>Hippius needs access to your movies folder to sync media files.</string> -->
    <!-- <key>NSPicturesUsageDescription</key>
    <string>Hippius needs access to your pictures folder to sync media files.</string> -->
</dict>
</plist> 
