  "lone_surrogates": {
    "rule": "A lone UTF-16 surrogate (U+D800-U+DBFF not followed by U+DC00-U+DFFF, or U+DC00-U+DFFF not preceded by U+D800-U+DBFF) becomes U+FFFD, as String.prototype.toWellFormed and a lossy UTF-8 decode do. The console does this to the text and the name before sealing, so it never writes a lone surrogate escape. Plaintexts sealed before that may hold one as a \\uXXXX escape: each case's plaintext must open to its text and name, the name then cleaned as `names` says (U+FFFD draws a glyph, so it is never blank). Sealing a case's text and name again gives {\"text\":text,\"name\":name} with no lone surrogate escape.",
    "cases": [
      {
        "label": "lone high surrogate in a name",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"a\\ud800b\"}",
        "text": "Hi",
        "name": "a\ufffdb"
      },
      {
        "label": "lone low surrogate in a name",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"a\\udc00b\"}",
        "text": "Hi",
        "name": "a\ufffdb"
      },
      {
        "label": "reversed pair in a name",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"a\\udc00\\ud800b\"}",
        "text": "Hi",
        "name": "a\ufffd\ufffdb"
      },
      {
        "label": "high surrogate at the end of a name",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"Sam\\ud83d\"}",
        "text": "Hi",
        "name": "Sam\ufffd"
      },
      {
        "label": "a pair then a lone low surrogate",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"\ud83d\ude00\\ude00\"}",
        "text": "Hi",
        "name": "\ud83d\ude00\ufffd"
      },
      {
        "label": "a valid pair is untouched",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"\ud83d\ude00\"}",
        "text": "Hi",
        "name": "\ud83d\ude00"
      },
      {
        "label": "only lone surrogates is a name, not blank",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"\\udc00\\udc00\"}",
        "text": "Hi",
        "name": "\ufffd\ufffd"
      },
      {
        "label": "spaces around a lone surrogate are trimmed",
        "plaintext": "{\"text\":\"Hi\",\"name\":\" \\ud800 \"}",
        "text": "Hi",
        "name": "\ufffd"
      },
      {
        "label": "a lone surrogate counts once toward the limit",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\ud800b\"}",
        "text": "Hi",
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ufffd"
      },
      {
        "label": "a bidi control between the halves of a pair does not rejoin them",
        "plaintext": "{\"text\":\"Hi\",\"name\":\"\\ud83d\\u202e\\ude00\"}",
        "text": "Hi",
        "name": "\ufffd\ufffd"
      },
      {
        "label": "lone surrogate in the text",
        "plaintext": "{\"text\":\"a\\udfffb\",\"name\":null}",
        "text": "a\ufffdb",
        "name": null
      }
    ]
  }
