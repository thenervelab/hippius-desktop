{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main-window capability: fs/opener/updater/process, dialogs, event communication. The fs plugin reaches only what the user picks in a dialog or drops on the window (both scoped at runtime by the plugins) and the app's own folders; files open in their app through the open_in_default_app command, which checks the file is in a synced folder. NOT granted to the tray-panel popover (see tray-panel.json).",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "notification:default",
        "opener:allow-reveal-item-in-dir",
        "deep-link:default",
        "deep-link:allow-register",
        "fs:default",
        "fs:allow-write-file",
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:event:allow-emit",
        "core:event:allow-emit-to",
        "dialog:allow-save",
        "dialog:default",
        "core:menu:allow-set-text",
        "core:menu:allow-insert",
        "core:menu:allow-remove",
        "core:menu:allow-new",
        "core:menu:allow-items",
        "core:menu:allow-get",
        "core:tray:default",
        "updater:default",
        "process:default",
        "process:allow-restart",
        "core:window:default",
        "core:window:allow-start-dragging",
        "core:window:allow-hide",
        "core:window:allow-close",
        "core:window:allow-set-size",
        "core:window:allow-center",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-unminimize",
        "core:window:allow-set-resizable",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen",
        "core:webview:allow-set-webview-zoom"
    ]
}
