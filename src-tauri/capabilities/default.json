{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main-window capability: DB read/write, fs/opener/updater/process, event communication. NOT granted to the tray-panel popover (see tray-panel.json) — audit H-13.",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "opener:allow-reveal-item-in-dir",
        "deep-link:default",
        "deep-link:allow-register",
        "fs:default",
        {
            "identifier": "opener:allow-open-path",
            "allow": [{
                "path": "/**/*",
                "recursive": true
            }],
            "options": {
                "ask": {
                    "message": "Hippius App would like to open your syncing files folder",
                    "title": "Allow folder access"
                }
            }
        },
        {
            "identifier": "fs:allow-exists",
            "allow": [{
                "path": "$APPLOCALDATA/hippius-desktop.db"
            }]
        },
        {
            "identifier": "fs:allow-write-file",
            "allow": [{
                "path": "$APPLOCALDATA/hippius-desktop.db"
            }]
        },
        {
            "identifier": "fs:allow-read-file",
            "allow": [{
                "path": "$APPLOCALDATA/hippius-desktop.db"
            }, {
                "path": "$HOME/**"
            }],
            "deny": [{
                "path": "$HOME/.hippius/**"
            }, {
                "path": "$HOME/.hippius"
            }]
        },
        {
            "identifier": "fs:allow-applocaldata-read-recursive",
            "allow": [{
                "path": "$APPLOCALDATA/hippius-desktop.db"
            }]
        },
        {
            "identifier": "fs:allow-applocaldata-write-recursive",
            "allow": [{
                "path": "$APPLOCALDATA/hippius-desktop.db"
            }]
        },
        {
            "identifier": "fs:allow-mkdir",
            "allow": [{
                "path": "$APPLOCALDATA"
            }]
        },
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:event:allow-emit",
        "core:event:allow-emit-to",
        "dialog:allow-save",
        "dialog:default",
        "core:menu:allow-set-text",
        "core:menu:allow-insert",
        "core:menu:allow-remove",
        "core:menu:allow-new",
        "core:menu:allow-items",
        "core:menu:allow-get",
        "core:tray:default",
        "updater:default",
        "process:default",
        "process:allow-restart",
        "core:window:default",
        "core:window:allow-start-dragging",
        "core:window:allow-hide",
        "core:window:allow-close",
        "core:window:allow-set-size",
        "core:window:allow-center",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-unminimize",
        "core:window:allow-set-resizable",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen",
        "core:webview:allow-set-webview-zoom"
    ]
}
