# Source of truth for the Finder extension App Group identifier.
# TEAMID comes from the Developer ID Application certificate
# ("Developer ID Application: T34 Corporation FZCO (V28B5X732P)").
# A Team-ID-prefixed group ID is unrestricted on macOS — no Apple-portal
# registration is required for Developer ID distribution.
HIPPIUS_TEAM_ID=V28B5X732P
HIPPIUS_APP_GROUP=V28B5X732P.com.hippius.shared
